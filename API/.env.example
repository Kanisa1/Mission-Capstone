# Email Configuration
# For Gmail: Create an App Password (https://support.google.com/accounts/answer/185833)
# Then use your full Gmail address as SENDER_EMAIL and the app password as SENDER_PASSWORD

ENABLE_EMAIL=true
SENDER_EMAIL=mineraltrace.system@gmail.com
SENDER_PASSWORD=your_gmail_app_password_here
ADMIN_EMAIL=admin@mineraltrace.com

# SMTP Settings (Gmail defaults shown)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# For development/testing, you can set ENABLE_EMAIL=false to skip actual email sending
# and just log the email contents instead
