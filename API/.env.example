# Email Configuration
# Copy to API/.env and set real values in local/dev.
# In Render, set these via Environment Variables.
ENABLE_EMAIL=true
SENDER_EMAIL=your-sender-email@example.com
SENDER_PASSWORD=your-app-password
ADMIN_EMAIL=admin@example.com

# SMTP Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# CORS (comma-separated list for production)
# Example: https://mineraltrace-web.onrender.com
ALLOWED_ORIGINS=*

# Blockchain anchoring (optional side-layer, does not change core model logic)
# Start with Polygon Amoy (testnet), then switch to Polygon mainnet later.
BLOCKCHAIN_ANCHOR_ENABLED=false
BLOCKCHAIN_NETWORK=polygon-amoy
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_FROM_ADDRESS=
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_EXPLORER_BASE=https://amoy.polygonscan.com/tx/
