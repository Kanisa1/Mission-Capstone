# Email Configuration
# Copy to API/.env and set real values in local/dev.
# In Render, set these via Environment Variables.
ENABLE_EMAIL=true
SENDER_EMAIL=your-sender-email@example.com
SENDER_PASSWORD=your-app-password
ADMIN_EMAIL=admin@example.com

# SMTP Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# CORS (comma-separated list for production)
# Example: https://mineraltrace-web.onrender.com
ALLOWED_ORIGINS=*
