# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Blockchain Configuration (Optional)
BLOCKCHAIN_ANCHOR_ENABLED=false
BLOCKCHAIN_RPC_URL=https://polygon-amoy.infura.io/v3/YOUR-PROJECT-ID
BLOCKCHAIN_PRIVATE_KEY=your-private-key-hex
BLOCKCHAIN_FROM_ADDRESS=your-ethereum-address
BLOCKCHAIN_EXPLORER_BASE=https://amoy.polygonscan.com/tx/

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=*

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password
